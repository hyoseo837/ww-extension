# Copy this file to server/.env and fill in real values.
# server/.env is gitignored; never commit real secrets.

# Supabase project — Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API keys — Settings → API keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# JWKS endpoint for verifying user session JWTs
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Gemini API key — Google AI Studio (https://aistudio.google.com/apikey).
# Server-owned key for a dedicated Google Cloud project (NOT a personal
# project). The backend bills Google for everyone's usage; users see only
# credits. Mark this as ENCRYPTED in DO App Platform env.
GEMINI_API_KEY=AIzaSy...

# Supabase Postgres — top-right Connect button → "Session pooler" tab.
# Use the Session pooler, NOT Direct connection or Transaction pooler:
#   - Direct connection (port 5432) is IPv6-only without the paid IPv4
#     add-on; many dev hosts and DO regions can't reach it.
#   - Transaction pooler (port 6543) is IPv4 but doesn't support
#     prepared statements, which breaks asyncpg's default cache.
#   - Session pooler (port 5432) is IPv4 AND supports prepared
#     statements — works everywhere with no asyncpg config.
# Note the username is "postgres.<project-ref>", not just "postgres".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Stripe (v4.5) — use TEST mode keys until going live.
# Secret key: Stripe Dashboard → Developers → API keys (sk_test_...).
# Mark this ENCRYPTED in DO App Platform env.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Webhook signing secret for checkout.session.completed (whsec_...):
#   - Local: `stripe listen --forward-to localhost:8000/webhooks/stripe`
#   - Deployed: Dashboard → Developers → Webhooks → add
#     {PUBLIC_BASE_URL}/webhooks/stripe, then copy its signing secret.
# Mark this ENCRYPTED in DO App Platform env.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Public base URL of THIS backend — used to build Stripe success/cancel
# return URLs (Stripe requires http(s); a chrome-extension:// URL is not
# allowed). DO app URL in prod, http://localhost:8000 for local dev.
# Public-by-design; store plain in DO App Platform env.
PUBLIC_BASE_URL=https://ww-extension-backend-x5h6h.ondigitalocean.app

# Comma-separated browser origins allowed by CORS — the web app (v6.1).
# Defaults in config.py cover local dev + prod; override per environment.
# Bearer-token auth (no cookies), so credentials are off. Public-by-design.
CORS_ORIGINS=http://localhost:5173,https://ww-extension.hyoseo.dev
