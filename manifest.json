{
  "manifest_version": 3,
  "name": "WW Extension",
  "version": "5.2.5",
  "description": "AI job scorer for WaterlooWorks",
  "key": "",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://waterlooworks.uwaterloo.ca/*",
    "https://bumrzedwwfhbxlttwboh.supabase.co/*",
    "https://ww-extension-backend-x5h6h.ondigitalocean.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://waterlooworks.uwaterloo.ca/myAccount/co-op/full/jobs.htm*"],
      "js": ["src/content.js"],
      "css": ["src/sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page-bridge.js"],
      "matches": ["https://waterlooworks.uwaterloo.ca/*"]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {},
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
