# Copy this file to web/.env and fill in real values.
# web/.env is gitignored. Every value here is PUBLIC by design — it ships
# in the SPA bundle. Never put a secret key in a VITE_ variable.

# Supabase project — Settings → API. Same project as the backend.
# The browser uses the publishable (anon) key, not the secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend base URL (FastAPI). http://localhost:8000 for local dev.
VITE_API_BASE_URL=https://ww-extension-backend-x5h6h.ondigitalocean.app

# Sentry error monitoring (v8.10, ADR 0049) — the WEB project's DSN (a
# separate Sentry project from the server's). DSNs are public-by-design.
# Empty/absent = Sentry never initializes. In prod, set on Vercel.
VITE_SENTRY_DSN=
